# Select the active region: us | eu | apac  (default: us)
REGION=us

# Optional: point the framework at a private ParaBank deployment.
# Defaults target the shared public demo at parabank.parasoft.com.
PARABANK_UI_BASE_URL=https://parabank.parasoft.com/parabank
PARABANK_API_BASE_URL=https://parabank.parasoft.com/parabank/services/bank

# Seeded read-only demo credentials (shared by all regions).
PARABANK_SEEDED_USERNAME=john
PARABANK_SEEDED_PASSWORD=demo
