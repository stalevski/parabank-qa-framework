{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@config": ["./src/config/regions.config.ts"],
      "@core/*": ["./src/core/*"],
      "@pages/*": ["./src/pages/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@parabank-fixtures": ["./src/fixtures/parabank/index.ts"],
      "@models/*": ["./src/models/*"],
      "@builders/*": ["./src/builders/*"],
      "@schemas/*": ["./src/schemas/*"]
    }
  },
  "include": ["playwright.config.ts", "src/**/*.ts", "tests/**/*.ts"]
}
