{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParaBank Customer",
  "description": "Derived from the published OpenAPI schema 'Customer' (components/schemas/Customer).",
  "type": "object",
  "required": ["id", "firstName", "lastName", "address", "phoneNumber", "ssn"],
  "properties": {
    "id": { "type": "integer" },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "address": {
      "type": "object",
      "required": ["street", "city", "state", "zipCode"],
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zipCode": { "type": "string" }
      }
    },
    "phoneNumber": { "type": "string" },
    "ssn": { "type": "string" }
  },
  "additionalProperties": true
}
