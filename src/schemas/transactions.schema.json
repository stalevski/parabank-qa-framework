{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParaBank Transactions",
  "description": "Derived from the published OpenAPI schema 'Transaction'. NOTE: 'date' is epoch milliseconds in the real response (drift from the declared string/date-time).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "accountId", "type", "date", "amount", "description"],
    "properties": {
      "id": { "type": "integer" },
      "accountId": { "type": "integer" },
      "type": { "type": "string", "enum": ["Credit", "Debit"] },
      "date": { "type": "number" },
      "amount": { "type": "number" },
      "description": { "type": "string" }
    },
    "additionalProperties": true
  }
}
